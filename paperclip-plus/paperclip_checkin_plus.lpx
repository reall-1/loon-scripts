#!name=Paperclip · 签到合集 Plus
#!desc=paperclip 全部在用签到脚本的定时签到，每个脚本一个签到开关（默认全开，没抓 Cookie 的脚本会自动跳过）；打开统一通知后每天 11:30 一条汇总；Cookie 用「Paperclip · Cookie 抓取合集」插件获取，抓完关掉即可。
#!author=MaYIHEI
#!homepage=https://github.com/MaYIHEI/paperclip/tree/main/loon/paperclip-checkin
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png
#!loon_version = 3.5.1(983)
#!tag=签到

[Argument]
merge = switch,true,tag=【统一通知】每天 11:30 汇总,desc=打开后各脚本不再单独弹通知，11:30 发一条汇总；关闭则各自通知
newmixc = switch,true,tag=【一点万象】签到
mishop = switch,true,tag=【小米商城】签到
milottery = switch,true,tag=【小米抽奖】签到
qqmusic = switch,true,tag=【QQ音乐】签到与任务
wanda = switch,true,tag=【万达电影】签到
wps = switch,true,tag=【WPS】签到与福利
agentrouter = switch,true,tag=【AgentRouter】签到
sgcc = switch,true,tag=【网上国网】签到
heybox = switch,true,tag=【小黑盒】签到
tuhu = switch,true,tag=【途虎养车】签到
haidilao = switch,true,tag=【海底捞】签到

glados_extra = switch,true,tag=【GLaDOS】签到
qdreader_extra = switch,true,tag=【起点读书】签到
smzdm_extra = switch,true,tag=【什么值得买】签到

glados_cron = input,"10 7 * * *",tag=【GLaDOS】执行时间
qdreader_cron = input,"11 2 * * *",tag=【起点读书】执行时间
smzdm_cron = input,"15 8 * * *",tag=【什么值得买】执行时间
[Script]
cron "30 11 * * *" then script("https://raw.githubusercontent.com/reall-1/loon-scripts/main/paperclip-plus/paperclip_plus_summary.js", {${newmixc}, ${mishop}, ${milottery}, ${qqmusic}, ${wanda}, ${wps}, ${agentrouter}, ${sgcc}, ${heybox}, ${tuhu}, ${haidilao}}) with tag="签到汇总", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", enable=${merge}
cron "37 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/newmixc/newmixc.js", {${merge}}) with tag="一点万象签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/newmixc.png", enable=${newmixc}
cron "15 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/mishop/mishop.js", {${merge}}) with tag="小米商城签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png", enable=${mishop}
cron "30 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/milottery/milottery.js", {${merge}}) with tag="小米抽奖签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png", timeout=360, enable=${milottery}
cron "0 30 7 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/qqmusic/qqmusic.js", {${merge}}) with tag="QQ音乐每日任务", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/qqmusic.png", enable=${qqmusic}
cron "0 * 9-10 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/qqmusic/qqmusic.js", {${merge}}) with tag="QQ音乐定时金币", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/qqmusic.png", enable=${qqmusic}
cron "0 5 0,8,12,16,20,22 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/qqmusic/qqmusic.js", {${merge}}) with tag="QQ音乐红包雨", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/qqmusic.png", enable=${qqmusic}
cron "20 9 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wanda/wanda.js", {${merge}}) with tag="万达电影签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wanda.png", enable=${wanda}
cron "0 10 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.js", {${merge}}) with tag="WPS签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png", enable=${wps}
cron "0 9 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/agentrouter/agentrouter.js", {${merge}}) with tag="AgentRouter签到", img_url="https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/agentrouter/icon.png", timeout=300, enable=${agentrouter}
cron "30 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/sgcc/sgcc.js", {${merge}}) with tag="网上国网签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/sgcc.png", timeout=60, enable=${sgcc}
cron "20 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/heybox/heybox.js", {${merge}}) with tag="小黑盒签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/heybox.png", enable=${heybox}
cron "17 7 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/tuhu/tuhu.js", {${merge}}) with tag="途虎养车签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/tuhu.png", enable=${tuhu}
cron "23 7 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/haidilao/haidilao.js", {${merge}}) with tag="海底捞签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/haidilao.png", enable=${haidilao}

# 签到数据:小组件请求 http://1.1.1.1/checkin/all 时返回登记索引和全部签到状态 JSON(只读,不跑签到)
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/checkin\/all(\?|$)/i then script("https://raw.githubusercontent.com/reall-1/loon-scripts/main/paperclip-plus/paperclip_plus_summary.js") with tag="签到数据", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", timeout=10

cron ${glados_cron} then script("https://raw.githubusercontent.com/curtinp118/Scripthub/main/scripts/glados/glados.js") with tag="GLaDOS签到", timeout=120, enable=${glados_extra}

cron ${qdreader_cron} then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Tasks/QDReader/qdreader.js", "[false,false,false,false,false,false,false]") with tag="起点读书签到", timeout=60, enable=${qdreader_extra}

cron ${smzdm_cron} then script("https://raw.githubusercontent.com/reall-1/loon-scripts/main/smzdm_loon.js") with tag="什么值得买签到", timeout=300, enable=${smzdm_extra}
