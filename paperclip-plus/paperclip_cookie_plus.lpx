#!name=Paperclip · Cookie 抓取合集 Plus
#!desc=抓取 paperclip 全部在用签到脚本的 Cookie。打开本插件，进要用的 App 或小程序页面，收到「✅ <名称> Cookie 获取成功」后关掉本插件，避免一直解密这些域名。签到用「Paperclip · 签到合集」。
#!author=MaYIHEI
#!homepage=https://github.com/MaYIHEI/paperclip/tree/main/loon/paperclip-cookie
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-cookie.png
#!loon_version = 3.5.1(983)
#!tag=签到, Cookie

[Script]
request if ${url} ~= /^https:\/\/app\.mixcapp\.com\/mixc\/api\/v4\/member\/getPersonalData/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/newmixc/newmixc.cookie.js") with tag="一点万象 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/newmixc.png"
request if ${url} ~= /^https:\/\/shop-api\.retail\.mi\.com\/mtop\/mf\/act\/infinite\/(do|done)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/mishop/mishop.cookie.js") with tag="小米商城 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png"
request if ${url} ~= /^https:\/\/shop-api\.retail\.mi\.com\/mtop\/navi\/venue\/batch/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/milottery/milottery.js") with tag="小米抽奖 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png", requires_body=true
request if ${url} ~= /^https:\/\/u6\.y\.qq\.com\/cgi-bin\/musics\.fcg\?.*(EveryDaySignLvzScore|GetSignInSummary)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/qqmusic/qqmusic.js") with tag="QQ音乐 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/qqmusic.png", requires_body=true
request if ${url} ~= /^https:\/\/user-api-prd-mx\.wandafilm\.com\/user\/user_info/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wanda/wanda.cookie.js") with tag="万达电影 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wanda.png"
request if ${url} ~= /^https:\/\/personal-act\.wps\.cn\/activity-rubik\/activity\/page_info/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.cookie.js") with tag="WPS Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png"
request if ${url} ~= /^https:\/\/api\.xiaoheihe\.cn\/task\/sign_list/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/heybox/heybox.js") with tag="小黑盒 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/heybox.png"
request if ${url} ~= /https:\/\/api\.tuhu\.cn\/User\/(GetMemberSignInInfoAsync|GetRightsList)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/tuhu/tuhu.js") with tag="途虎养车 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/tuhu.png"
request if ${url} ~= /^https:\/\/superapp-public\.kiwa-tech\.com\/activity\/wxapp\/signin\/(query|querySite|querySwitch|queryFragment|signin)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/haidilao/haidilao.js") with tag="海底捞 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/haidilao.png"

request if ${url} ~= /^https:\/\/(glados\.network|railgun\.info|glados\.vip|glados\.one|glados\.space)\/console\/account$/ then script("https://raw.githubusercontent.com/curtinp118/Scripthub/main/scripts/glados/glados.js") with tag="GLaDOS获取凭证"

response if ${url} ~= /^https?:\/\/h5\.if\.qidian\.com\/argus\/api\/v1\/user\/getlogininfo/ then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Tasks/QDReader/qdreader.js", "[false]") with tag="起点读书获取凭证", requires_body=true

request if ${url} ~= /^https:\/\/user-api\.smzdm\.com\/(?:checkin|task\/list_v2)(?:[\/?]|$)/ then script("https://raw.githubusercontent.com/reall-1/loon-scripts/main/smzdm_loon.js") with tag="什么值得买获取凭证"

[MITM]
hostname = app.mixcapp.com, shop-api.retail.mi.com, u6.y.qq.com, user-api-prd-mx.wandafilm.com, personal-act.wps.cn, api.xiaoheihe.cn, api.tuhu.cn, superapp-public.kiwa-tech.com, glados.network, railgun.info, glados.vip, glados.one, glados.space, h5.if.qidian.com, user-api.smzdm.com
