#!name=什么值得买签到
#!desc=按设定时间签到、浏览和领奖。首次使用或凭证失效时开启抓取 Cookie。
#!author=Cat-zaizai, Codex
#!arguments-desc=- CRONEXP: 默认每天 08:15 执行。\n\n- 是否开启抓取 Cookie: 默认关闭，首次使用或凭证失效时开启。

[Argument]
CAPTURE_ENABLE=switch,"false","true",tag=是否开启抓取 Cookie, desc=收到凭证保存通知后可关闭。
CRONEXP=input,"15 8 * * *",tag=CRONEXP, desc=执行时间，默认每天 08:15。

[Script]
http-request ^https:\/\/user-api\.smzdm\.com\/(?:checkin|task\/list_v2)(?:[/?]|$) script-path=https://raw.githubusercontent.com/reall-1/loon-scripts/main/smzdm_loon.js, timeout=10, tag=什么值得买获取凭证, enable={CAPTURE_ENABLE}
cron {CRONEXP} script-path=https://raw.githubusercontent.com/reall-1/loon-scripts/main/smzdm_loon.js, timeout=300, tag=什么值得买签到

[MITM]
hostname = user-api.smzdm.com
