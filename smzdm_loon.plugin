#!name=什么值得买签到
#!desc=打开什么值得买 App 的签到或任务中心保存凭证，每天 08:15 执行签到、浏览和领奖。
#!author=Cat-zaizai, Codex

[Script]
http-request ^https:\/\/user-api\.smzdm\.com\/(?:checkin|task\/list_v2)(?:[/?]|$) script-path=https://raw.githubusercontent.com/reall-1/loon-scripts/main/smzdm_loon.js, timeout=10, tag=什么值得买获取凭证
cron "15 8 * * *" script-path=https://raw.githubusercontent.com/reall-1/loon-scripts/main/smzdm_loon.js, timeout=300, tag=什么值得买签到

[MITM]
hostname = user-api.smzdm.com
